-- หัวข้อหมวดหมู่
local function createCategory(name)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 25)
	label.BackgroundTransparency = 1
	label.Text = "📌 " .. name
	label.TextColor3 = Color3.fromRGB(255, 215, 0)
	label.TextSize = 15
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = Container
end

-- ปุ่มเปิด/ปิด (สีเขียว = เปิด, สีแดง = ปิด)
local function createToggle(name, defaultState, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 35)
	btn.BackgroundColor3 = defaultState and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
	btn.Text = "  " .. name .. (defaultState and " [เปิด]" or " [ปิด]")
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 14
	btn.Font = Enum.Font.Gotham
	btn.TextXAlignment = Enum.TextXAlignment.Left
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

	local state = defaultState
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.BackgroundColor3 = state and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
		btn.Text = "  " .. name .. (state and " [เปิด]" or " [ปิด]")
		pcall(function() callback(state) end)
	end)
	btn.Parent = Container
	return btn
end

-- ปุ่มรวมหลายฟังก์ชัน / สลับโหมด (สีขาว)
local function createMultiOptionButton(name, options, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 35)
	btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- สีขาวตามเงื่อนไข
	btn.TextColor3 = Color3.fromRGB(30, 30, 30) -- ข้อความสีเข้มให้อ่านง่าย
	btn.TextSize = 14
	btn.Font = Enum.Font.GothamBold
	btn.TextXAlignment = Enum.TextXAlignment.Left
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

	local currentIndex = 1
	btn.Text = "  " .. name .. ": " .. options[currentIndex]

	btn.MouseButton1Click:Connect(function()
		currentIndex = currentIndex % #options + 1
		btn.Text = "  " .. name .. ": " .. options[currentIndex]
		pcall(function() callback(options[currentIndex]) end)
	end)
	btn.Parent = Container
	return btn
end

-- ช่องใส่ตัวเลข / ตัวอักษร
local function createInput(placeholder, callback)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, 0, 0, 35)
	box.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	box.PlaceholderText = placeholder
	box.Text = ""
	box.TextColor3 = Color3.fromRGB(255, 255, 255)
	box.PlaceholderColor3 = Color3.fromRGB(160, 160, 160)
	box.TextSize = 14
	box.Font = Enum.Font.Gotham
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

	box.FocusLost:Connect(function(enterPressed)
		pcall(function() callback(tonumber(box.Text) or box.Text) end)
	end)
	box.Parent = Container
	return box
end

